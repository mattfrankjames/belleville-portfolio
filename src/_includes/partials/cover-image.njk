{#-
	Renders a project cover.

	A normal cover goes through the build image pipeline (AVIF/WebP at several
	widths). An animated cover (cover.animated) is served as-is, because the
	pipeline would flatten it: the page ships the still frame, and
	/assets/js/animation.js swaps in the animation and adds a Pause button
	(WCAG 2.2.2 — the animation loops for longer than five seconds).

	Usage: {{ coverImage(cover, alt, sizes, eager) }}
#}
{%- macro coverImage(cover, alt = "", sizes = "100vw", eager = false) -%}
{%- if cover.animated %}
<div class="animated-image" data-animation data-animation-src="{{ cover.src }}" data-animation-still="{{ cover.still }}">
	<img class="card-image" src="{{ cover.still }}" alt="{{ alt }}" width="{{ cover.width }}" height="{{ cover.height }}"{% if eager %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async" eleventy:ignore>
</div>
{%- else %}
<img class="card-image" src="{{ cover.src }}" alt="{{ alt }}" sizes="{{ sizes }}"{% if eager %} loading="eager" fetchpriority="high"{% endif %}>
{%- endif %}
{%- endmacro -%}
