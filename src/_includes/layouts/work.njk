---
layout: base
scripts:
  - /assets/js/carousel.js
---
{%- from "partials/carousel.njk" import carousel %}
<div class="wrapper region flow">
	{% include "partials/page-header.njk" %}
	{%- if content | trim %}
	<div class="prose flow">
		{{ content | safe }}
	</div>
	{%- endif %}
</div>

{%- for section in sections %}
{%- set sectionProjects = collections.projects | bySection(section.id) %}
{%- if sectionProjects.length %}
<section class="work-section wrapper region flow">
	<h2 id="section-{{ section.id }}">{{ section.title }}</h2>
	{{ carousel(section, sectionProjects) }}
</section>
{%- endif %}
{%- endfor %}
