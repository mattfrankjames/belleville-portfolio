---
layout: base
---
<div class="wrapper region flow">
	{% include "partials/page-header.njk" %}
	{%- if content | trim %}
	<div class="prose flow">
		{{ content | safe }}
	</div>
	{%- endif %}
	<p><a class="email-link" href="mailto:{{ site.email }}">{{ site.email }}</a></p>
	{%- if site.social.length %}
	<h2>Elsewhere</h2>
	<ul class="social-list" role="list">
		{%- for link in site.social %}
		<li><a href="{{ link.url }}" rel="me">{{ link.label }}</a></li>
		{%- endfor %}
	</ul>
	{%- endif %}
</div>
