<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	{% include "partials/meta.njk" %}
	<meta name="color-scheme" content="light dark">
	<meta name="theme-color" content="#ECCFC3" media="(prefers-color-scheme: light)">
	<meta name="theme-color" content="#54392D" media="(prefers-color-scheme: dark)">
	{#- Preload the two fonts every page uses above the fold (Latin subsets). #}
	<link rel="preload" href="/assets/fonts/boldonse-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous">
	<link rel="preload" href="/assets/fonts/inter-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous">
	<link rel="stylesheet" href="/assets/css/main.css">
	<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
	<a class="skip-link" href="#content">Skip to content</a>
	{%- if not hideHeader %}
	{% include "partials/header.njk" %}
	{%- endif %}
	<main id="content" tabindex="-1">
		{{ content | safe }}
	</main>
	{% include "partials/footer.njk" %}
	{%- for script in scripts %}
	<script type="module" src="{{ script }}"></script>
	{%- endfor %}
</body>
</html>
