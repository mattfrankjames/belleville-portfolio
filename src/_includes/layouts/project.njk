---
layout: base
scripts:
  - /assets/js/animation.js
---
{%- from "partials/cover-image.njk" import coverImage %}
{%- set previousProject = collections.projects | getPreviousCollectionItem %}
{%- set nextProject = collections.projects | getNextCollectionItem %}
<article class="project">
	<header class="project-header wrapper region flow">
		<h1>{{ title }}</h1>
		{%- if summary %}
		<p class="lede">{{ summary }}</p>
		{%- endif %}
		{%- if client or year or role or services %}
		<dl class="project-meta">
			{%- if client %}<div><dt>Client</dt><dd>{{ client }}</dd></div>{% endif %}
			{%- if year %}<div><dt>Year</dt><dd>{{ year }}</dd></div>{% endif %}
			{%- if role %}<div><dt>Role</dt><dd>{{ role }}</dd></div>{% endif %}
			{%- if services %}<div><dt>Services</dt><dd>{{ services | join(", ") }}</dd></div>{% endif %}
		</dl>
		{%- endif %}
	</header>

	{%- if cover and cover.src and imageLayout != "row" %}
	<div class="project-cover wrapper">
		{#- Likely LCP element: load eagerly at high priority. #}
		{{ coverImage(cover, cover.alt, "(min-width: 76rem) 72rem, calc(100vw - 2rem)", true) }}
	</div>
	{%- endif %}

	<div class="project-body wrapper region">
		<div class="prose flow">
			{{ content | safe }}
		</div>
	</div>

	{%- if gallery.length %}
	{#- imageLayout: "row" puts the cover in the grid with the rest;
	    "masonry" packs images into columns; the default stacks them. #}
	{%- set layout = imageLayout or "stack" %}
	{%- set gallerySizes = "(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, calc(100vw - 2rem)" if layout != "stack" else "(min-width: 76rem) 72rem, calc(100vw - 2rem)" %}
	<div class="project-gallery wrapper region" data-layout="{{ layout }}">
		<h2 class="visually-hidden">{{ "Project images" if layout == "row" else "More images from this project" }}</h2>
		<ul role="list">
			{%- if layout == "row" and cover and cover.src %}
			<li><img src="{{ cover.src }}" alt="{{ cover.alt }}" sizes="{{ gallerySizes }}" loading="eager" fetchpriority="high"></li>
			{%- endif %}
			{%- for image in gallery %}
			<li><img src="{{ image.src }}" alt="{{ image.alt }}" sizes="{{ gallerySizes }}"></li>
			{%- endfor %}
		</ul>
	</div>
	{%- endif %}
</article>

<nav class="pager wrapper region" aria-label="More projects">
	<ul role="list">
		{%- if previousProject %}
		<li class="pager-previous"><a href="{{ previousProject.url }}" rel="prev"><span class="pager-label">Previous project</span> {{ previousProject.data.title }}</a></li>
		{%- endif %}
		{%- if nextProject %}
		<li class="pager-next"><a href="{{ nextProject.url }}" rel="next"><span class="pager-label">Next project</span> {{ nextProject.data.title }}</a></li>
		{%- endif %}
	</ul>
	<p><a class="arrow-link" href="/work/">All work</a></p>
</nav>
